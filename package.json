{
  "name": "comprosody",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config server/vitest.config.ts",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:watch": "vitest",
    "diagnostic": "npx tsx scripts/prosody-pipeline-diagnostic.ts",
    "server": "npx tsx --watch server/index.ts",
    "server:prod": "NODE_ENV=production npx tsx server/index.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.16.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "dotenv": "^17.3.1",
    "epubjs": "^0.3.93",
    "express": "^5.2.1",
    "idb-keyval": "^6.3.0",
    "minisearch": "^7.2.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.3.0",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.9.10"
    }
  }
}
