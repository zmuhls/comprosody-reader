# Optional: required only for Ollama Cloud refinement routes; server-side only
OLLAMA_API_KEY=your-ollama-api-key
# Optional non-secret provider configuration
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=qwen3.5:397b
# OLLAMA_MAX_TOKENS=8192

# The API binds only to loopback by default. A non-loopback HOST also requires
# COMPROSODY_API_KEY so cloud credentials are not exposed on the local network.
# HOST=127.0.0.1
PORT=3001
# Optional: shared secret for API auth (required in production)
# COMPROSODY_API_KEY=your-secret-key
# Optional: restrict CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173

# Optional non-secret browser API base. Development defaults to /api and hosted
# production builds default to the Readings gateway at /studio/api.
# VITE_CADENCE_API_BASE_URL=http://127.0.0.1:3001/api

# Optional transcription provider: local (default, on-device) or elevenlabs (cloud upload)
# TRANSCRIPTION_PROVIDER=local
# Optional local quality/speed tradeoff: base (default), turbo, or large-v3-turbo
# FASTER_WHISPER_MODEL=large-v3-turbo
# Required only when using ElevenLabs Scribe or read-aloud; keep it server-side
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: override the ElevenLabs model (defaults to scribe_v2)
# ELEVENLABS_SCRIBE_MODEL=scribe_v2
# Read-aloud uses eleven_multilingual_v2 with per-request speed from 0.7 to 1.2
# and returns provider-aligned character timestamps for reader highlighting.
